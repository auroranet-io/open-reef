# Local dev — copy to .env.local and fill in values
DATABASE_URL=postgresql://openreef:openreef@localhost:5432/openreef

# Auth.js — generate NEXTAUTH_SECRET with: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# GitHub OAuth app — create at https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Legal footer links — leave blank to hide the link entirely
IMPRINT_URL=
PRIVACY_POLICY_URL=
# "Made with ♥ by <MAKER_NAME>" — leave MAKER_NAME blank to hide entirely
MAKER_NAME=
MAKER_URL=
